#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <signal.h>
#include "../inc/input.h"
#include "../inc/type.h"
void clearInputBuffer() {
}
void handle_signal(int sig){
	(void)sig;
	printf("\nThank you\n");
	exit(0);
}
void printInvalidInputMessage() {
}
intmax_t getPattern() {
	signal(SIGINT, handle_signal);
		printf("패턴 1: 삼각형\n");
		printf("패턴 6: 세로 삼각형\n");
		printf("패턴 7: 가로 삼각형\n");
		printf("패턴 8: Random Option\n\n");
				printInvalidInputMessage();
				clearerr(stdin);
				continue;
			}
			else{
				perror("fgets");
				exit(1);
			}
		if(strlen(buffer) > MAX_LINE || buffer[strlen(buffer) - 1] != '\n'){
			printInvalidInputMessage();
			clearInputBuffer();
			continue;
		}
}
intmax_t getLine(enum pattern_type choice) {
			if (feof(stdin)) {
				printInvalidInputMessage();
				clearerr(stdin);
				continue;
			}
			else {
				perror("fgets");
				exit(1);
			}
		}
		if (strlen(buffer) > MAX_LINE || buffer[strlen(buffer) - 1] != '\n') {
			printInvalidInputMessage();
			clearInputBuffer();
			continue;
		}
}
